% layout 'default';
% title 'Auto-Escalation Rules';

%= include 'partials/_breadcrumb', crumbs => [ { label => "Search", url => "/search" }, { label => "Auto-Escalation Rules" } ]

%= include 'partials/_error_alert', message => $error

%= include 'partials/_card', title => 'Auto-Escalation Rules', header_class => '', body_class => 'p-2', header_extra => begin
    % if ($can_manage) {
    <button type="button" class="btn btn-sm btn-danger" id="rule-add-btn">Add Rule</button>
    % } else {
    <span class="badge bg-secondary">read-only — set auto_escalation_manage_enable to edit</span>
    % }
% end, body => begin
    <div id="ae-action-status" class="small mb-2" style="display:none"></div>
    % if (@$rules) {
    <div class="table-responsive">
      <table class="table table-dark table-sm table-hover table-bordered mb-0" id="ae-rules-table">
        <thead class="table-secondary">
          <tr>
            <th>ID</th><th>Name</th><th>Enabled</th><th>Pri</th><th>Stop</th>
            <th>Tables</th><th>Matches</th><th>Last Matched</th><th>Description</th><th></th>
          </tr>
        </thead>
        <tbody>
          % for my $rule (@$rules) {
          <tr data-rule-id="<%= $rule->{id} %>">
            <td><%= $rule->{id} %></td>
            <td><%= $rule->{name} %></td>
            <td>
              % if ($can_manage) {
              <div class="form-check form-switch mb-0">
                <input class="form-check-input rule-toggle" type="checkbox"
                       data-rule-id="<%= $rule->{id} %>" <%= $rule->{enabled} ? 'checked' : '' %>>
              </div>
              % } elsif ($rule->{enabled}) {
              <span class="badge bg-success">enabled</span>
              % } else {
              <span class="badge bg-secondary">disabled</span>
              % }
            </td>
            <td><%= $rule->{priority} %></td>
            <td><%= $rule->{stop_on_match} ? 'yes' : '' %></td>
            <td class="small"><%= join(',', @{ $rule->{tables} }) %></td>
            <td><%= $rule->{match_count} %></td>
            <td class="text-muted small"><%= $rule->{last_matched} // '' %></td>
            <td><%= $rule->{description} // '' %></td>
            <td class="text-nowrap">
              % if ($can_manage) {
              <button type="button" class="btn btn-sm btn-outline-secondary py-0 rule-edit-btn"
                      data-rule-id="<%= $rule->{id} %>">Edit</button>
              <button type="button" class="btn btn-sm btn-outline-danger py-0 rule-delete-btn"
                      data-rule-id="<%= $rule->{id} %>" data-rule-name="<%= $rule->{name} %>">Delete</button>
              % } else {
              <button type="button" class="btn btn-sm btn-outline-secondary py-0 rule-edit-btn"
                      data-rule-id="<%= $rule->{id} %>">View</button>
              % }
            </td>
          </tr>
          % }
        </tbody>
      </table>
    </div>
    % } else {
    %= include 'partials/_empty_alert', message => "No auto-escalation rules configured yet.", extra_class => "mb-0"
    % }
% end

<!-- Add/edit/view rule modal. Phase 1 edits the match tree as JSON; the
     actions are built from the targets + note inputs. -->
%= include 'partials/_modal', id => 'rule-modal', title => 'Add Rule', title_id => 'rule-modal-title', dialog => 'modal-lg modal-dialog-scrollable', body => begin
        <input type="hidden" id="rule-id" value="">
        <div class="row g-2 mb-2">
          <div class="col-md-5">
            <label class="form-label small text-muted mb-1">Name</label>
            <input type="text" id="rule-name" class="form-control form-control-sm">
          </div>
          <div class="col-md-2">
            <label class="form-label small text-muted mb-1">Priority</label>
            <input type="text" id="rule-priority" class="form-control form-control-sm" value="100" inputmode="numeric">
          </div>
          <div class="col-md-5 d-flex align-items-end gap-3">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="rule-enabled" checked>
              <label class="form-check-label small" for="rule-enabled">Enabled</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="rule-stop">
              <label class="form-check-label small" for="rule-stop">Stop on match</label>
            </div>
          </div>
        </div>

        <div class="mb-2">
          <label class="form-label small text-muted mb-1">Tables</label>
          % # Ticked by default for the tables a rule with no scoping of its own
          % # gets; baphomet is left unticked, matching that opt-in default.
          <div class="d-flex gap-3">
            % for my $alert_table (@{ $self->alert_tables }) {
            <div class="form-check">
              <input class="form-check-input rule-table" type="checkbox" value="<%= $alert_table->{key} %>"
                     id="rule-table-<%= $alert_table->{key} %>" <%= $alert_table->{key} eq 'baphomet' ? '' : 'checked' %>>
              <label class="form-check-label small" for="rule-table-<%= $alert_table->{key} %>"><%= $alert_table->{key} %></label>
            </div>
            % }
          </div>
        </div>

        <div class="row g-2 mb-2">
          <div class="col-md-7">
            <label class="form-label small text-muted mb-1">Escalate to (target names or ids, comma separated)</label>
            <input type="text" id="rule-targets" class="form-control form-control-sm" list="rule-target-list" placeholder="soc-hook, ir">
            <datalist id="rule-target-list"></datalist>
          </div>
          <div class="col-md-5">
            <label class="form-label small text-muted mb-1">Note (optional)</label>
            <input type="text" id="rule-note" class="form-control form-control-sm">
          </div>
        </div>

        <div class="mb-2">
          <label class="form-label small text-muted mb-1">Description (optional)</label>
          <input type="text" id="rule-description" class="form-control form-control-sm">
        </div>

        <div class="mb-2">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label small text-muted mb-0">Match conditions</label>
            <button type="button" class="btn btn-sm btn-outline-secondary py-0" id="rule-json-toggle">Advanced (JSON)</button>
          </div>
          <div id="rule-builder" class="border border-secondary rounded p-2"></div>
          <textarea id="rule-match" class="form-control form-control-sm font-monospace mt-1" rows="8"
                    spellcheck="false" style="white-space:pre;display:none"></textarea>
          <div class="form-text text-muted">
            Build nested ALL / ANY / NOT groups of field tests, or switch to raw JSON. A field is an
            alert column (<code>malscore</code>, <code>signature</code>) or a dotted path into the raw
            payload (<code>raw.alert.severity</code>).
          </div>
        </div>

        <datalist id="rule-field-list">
          <option value="malscore"></option><option value="signature"></option>
          <option value="classification"></option><option value="src_ip"></option>
          <option value="dest_ip"></option><option value="src_port"></option>
          <option value="dest_port"></option><option value="proto"></option>
          <option value="app_proto"></option><option value="gid"></option>
          <option value="sid"></option><option value="raw.alert.severity"></option>
          <option value="raw.alert.signature"></option>
        </datalist>

        <div id="rule-error" class="text-warning small mb-2" style="display:none"></div>

        <!-- Dry-run preview -->
        <div class="border-top border-secondary pt-2">
          <div class="d-flex align-items-end gap-2 mb-2">
            <div>
              <label class="form-label small text-muted mb-1">Preview against last</label>
              <div class="input-group input-group-sm">
                <input type="text" id="rule-preview-minutes" class="form-control" value="60" inputmode="numeric" style="max-width:5rem">
                <span class="input-group-text">min of</span>
                <select id="rule-preview-table" class="form-select">
                  %= include 'partials/_table_options', lc => 1
                </select>
              </div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-info" id="rule-preview-btn">Run preview</button>
          </div>
          <div id="rule-preview-status" class="small mb-1" style="display:none"></div>
          <div id="rule-preview-results" class="table-responsive" style="display:none;max-height:260px;overflow-y:auto">
            <table class="table table-dark table-sm table-bordered mb-0">
              <thead class="table-secondary"><tr><th>ID</th><th>Time</th><th>Signature/Class</th><th>Src</th><th>Dest</th><th>Malscore</th></tr></thead>
              <tbody id="rule-preview-tbody"></tbody>
            </table>
          </div>
        </div>
% end, footer => begin
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        % if ($can_manage) {
        <button type="button" class="btn btn-sm btn-danger" id="rule-save-btn">Save</button>
        % }
% end

<script>
// Server-supplied bootstrap data for /js/auto-escalation.js.
window.LilithAutoEscalation = {
  rules:     <%== $rules_json %>,
  targets:   <%== $targets_json %>,
  canManage: <%= $can_manage ? 'true' : 'false' %>
};
</script>
<script src="/js/auto-escalation.js"></script>
