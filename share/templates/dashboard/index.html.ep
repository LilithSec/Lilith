% layout 'default';
% title 'Dashboard';

<link rel="stylesheet" href="/vendor/gridstack/gridstack.min.css">
<link rel="stylesheet" href="/css/dashboard.css">

<div class="card mb-3 border-secondary">
  <div class="card-body py-2">
    <div class="row g-2 align-items-end">
      <div class="col-auto">
        <label class="form-label">Dashboard</label>
        <select id="db-board" class="form-select form-select-sm" style="width:170px"></select>
      </div>
      <div class="col-auto">
        <label class="form-label">Default table</label>
        <select id="db-table" class="form-select form-select-sm" style="width:140px">
          <optgroup label="Alerts">
            %= include 'partials/_table_options', selected => $table
          </optgroup>
          % if ($self->allani_enabled) {
          <optgroup label="Logs (Allani)">
            <option value="syslog"     <%= $table eq 'syslog'     ? 'selected' : '' %>>syslog</option>
            <option value="http"       <%= $table eq 'http'       ? 'selected' : '' %>>http (access)</option>
            <option value="http_error" <%= $table eq 'http_error' ? 'selected' : '' %>>http error</option>
          </optgroup>
          % }
        </select>
      </div>
      %= include 'partials/_time_range', tr_minutes => $go_back_minutes
      <div class="col-auto">
        <label class="form-label">Bucket</label>
        <select id="db-bucket" class="form-select form-select-sm" style="width:100px"
                title="Time bucket for the over-time charts (auto sizes it to the window)">
          <option value="auto">auto</option>
          <option value="minute">minute</option>
          <option value="hour">hour</option>
          <option value="day">day</option>
          <option value="week">week</option>
          <option value="month">month</option>
        </select>
      </div>
      <div class="col-auto ms-auto d-flex align-items-center gap-3">
        <div class="form-check mb-0">
          <input class="form-check-input" type="checkbox" id="db-gpcd" <%= $show_gpcd ? 'checked' : '' %>>
          <label class="form-check-label small text-muted" for="db-gpcd"
                 title="Generic Protocol Command Decode">Show GPCD</label>
        </div>
        <button type="button" id="db-add-widget" class="btn btn-sm btn-outline-success db-edit-only">+ Add widget</button>
        <div class="btn-group btn-group-sm db-edit-only">
          <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown"
                  aria-expanded="false" title="Replace this dashboard's widgets with a built-in preset">Reset to&hellip;</button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><h6 class="dropdown-header">Alerts</h6></li>
            <li><a class="dropdown-item" href="#" data-preset="suricata">Suricata</a></li>
            <li><a class="dropdown-item" href="#" data-preset="cape">CAPE</a></li>
            <li><a class="dropdown-item" href="#" data-preset="baphomet">Baphomet</a></li>
            <li><a class="dropdown-item" href="#" data-preset="shodan">Shodan enrichment</a></li>
            % if ($self->allani_enabled) {
            <li><hr class="dropdown-divider"></li>
            <li><h6 class="dropdown-header">Logs (Allani)</h6></li>
            <li><a class="dropdown-item" href="#" data-preset="syslog">Syslog</a></li>
            <li><a class="dropdown-item" href="#" data-preset="http">HTTP (access + error)</a></li>
            <li><a class="dropdown-item" href="#" data-preset="http_access">HTTP Access</a></li>
            <li><a class="dropdown-item" href="#" data-preset="http_error">HTTP Error</a></li>
            % }
          </ul>
        </div>
        <button type="button" id="db-refresh" class="btn btn-sm btn-outline-danger">Refresh</button>
        <div class="btn-group btn-group-sm">
          <button type="button" id="db-edit" class="btn btn-outline-primary"
                  title="Toggle edit mode -- rearrange, add, and remove widgets">Edit</button>
          <button type="button" class="btn btn-outline-primary dropdown-toggle dropdown-toggle-split"
                  data-bs-toggle="dropdown" aria-expanded="false">
            <span class="visually-hidden">Dashboard actions</span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="#" id="db-new">New dashboard&hellip;</a></li>
            <li><a class="dropdown-item" href="#" id="db-rename">Rename&hellip;</a></li>
            <li><a class="dropdown-item" href="#" id="db-set-default">Set as default</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item text-danger" href="#" id="db-delete">Delete&hellip;</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div id="db-error" class="text-warning small mt-2" style="display:none"></div>
  </div>
</div>

<div class="grid-stack"></div>

<!-- Add / configure widget modal -->
%= include 'partials/_modal', id => 'widget-modal', title => 'Add widget', title_id => 'widget-modal-title', body => begin
        <div class="mb-2">
          <label class="form-label small text-muted mb-1">Table</label>
          <select id="wm-table" class="form-select form-select-sm">
            <option value="">Follow default table</option>
            <optgroup label="Alerts">
              %= include 'partials/_table_options'
            </optgroup>
            % if ($self->allani_enabled) {
            <optgroup label="Logs (Allani)">
              <option value="syslog">syslog</option>
              <option value="http">http (access)</option>
              <option value="http_error">http error</option>
            </optgroup>
            % }
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label small text-muted mb-1">Type</label>
          <select id="wm-type" class="form-select form-select-sm">
            <option value="timeseries">Alerts over time</option>
            <option value="top">Top values</option>
            <option value="countries">Source countries</option>
            <option value="stat">Stat (text)</option>
          </select>
        </div>
        <div class="mb-2" id="wm-metric-wrap">
          <label class="form-label small text-muted mb-1">Metric</label>
          <select id="wm-metric" class="form-select form-select-sm">
            <option value="total">Total count</option>
            <option value="distinct">Distinct values (of a column)</option>
            <option value="escalated">Escalated count</option>
            <option value="busiest">Busiest value (of a column)</option>
            <option value="shodan_src_coverage">Shodan coverage (sources)</option>
            <option value="shodan_src_staleness">Shodan staleness (sources)</option>
            <option value="shodan_dest_coverage">Shodan coverage (destinations)</option>
            <option value="shodan_dest_staleness">Shodan staleness (destinations)</option>
          </select>
        </div>
        <div class="mb-2" id="wm-column-wrap">
          <label class="form-label small text-muted mb-1">Column</label>
          <select id="wm-column" class="form-select form-select-sm"></select>
        </div>
        <div class="mb-2" id="wm-measure-wrap">
          <label class="form-label small text-muted mb-1">Measure</label>
          <select id="wm-measure" class="form-select form-select-sm"></select>
        </div>
        <div class="mb-2" id="wm-style-wrap">
          <label class="form-label small text-muted mb-1">Style</label>
          <select id="wm-style" class="form-select form-select-sm">
            <option value="bar">Bar</option>
            <option value="pie">Pie</option>
          </select>
        </div>
        <div class="mb-2" id="wm-limit-wrap">
          <label class="form-label small text-muted mb-1">Count (1&ndash;50)</label>
          <input type="number" id="wm-limit" class="form-control form-control-sm" min="1" max="50" step="1" value="10">
        </div>
        <div class="mb-2" id="wm-group-wrap">
          <label class="form-label small text-muted mb-1">Group by</label>
          <select id="wm-group" class="form-select form-select-sm"></select>
        </div>
        <div class="mb-2" id="wm-bucket-wrap">
          <label class="form-label small text-muted mb-1">Time bucket</label>
          <select id="wm-bucket" class="form-select form-select-sm">
            <option value="">Follow dashboard</option>
            <option value="auto">auto (size to window)</option>
            <option value="minute">minute</option>
            <option value="hour">hour</option>
            <option value="day">day</option>
            <option value="week">week</option>
            <option value="month">month</option>
          </select>
        </div>
        <div class="mb-2" id="wm-label-wrap">
          <label class="form-label small text-muted mb-1">Label (optional)</label>
          <input type="text" id="wm-label" class="form-control form-control-sm" maxlength="40" placeholder="defaults from the metric">
        </div>
        <div class="mb-2 form-check" id="wm-abbrev-wrap">
          <input type="checkbox" class="form-check-input" id="wm-abbrev">
          <label class="form-check-label small text-muted" for="wm-abbrev">Abbreviate large numbers (2010 to 2k)</label>
        </div>
        <div class="text-muted small">Time range and GPCD come from the dashboard controls; each
          widget can read a different table, or follow the dashboard's Default table.</div>
% end, footer => begin
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-sm btn-danger" id="wm-save">Save</button>
% end

<!-- New / rename dashboard modal -->
%= include 'partials/_modal', id => 'board-modal', title => 'New dashboard', title_id => 'board-modal-title', body => begin
        <label class="form-label small text-muted mb-1" for="board-name">Name</label>
        <input type="text" id="board-name" class="form-control form-control-sm" maxlength="64"
               placeholder="e.g. CAPE overview">
        <div id="board-modal-error" class="text-warning small mt-2" style="display:none"></div>
% end, footer => begin
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-sm btn-danger" id="board-modal-save">Save</button>
% end

<script src="/vendor/Chart.js"></script>
<script src="/vendor/gridstack/gridstack-all.js"></script>
<script src="/js/time-range.js"></script>
<script>
// Server-supplied bootstrap data for /js/dashboard.js: the view to open with.
window.LilithDashboard = {
  table:    '<%= $table %>',
  minutes:  <%= $go_back_minutes %>,
  showGpcd: <%= $show_gpcd ? 'true' : 'false' %>
};
</script>
<script src="/js/dashboard-presets.js"></script>
<script src="/js/dashboard.js"></script>
