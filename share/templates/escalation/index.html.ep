% layout 'default';
% title $can_edit ? 'Edit Escalation Targets' : 'Escalation Targets';

%= include 'partials/_breadcrumb', crumbs => [ { label => 'Search', url => '/search' }, { label => ( $can_edit ? 'Edit Escalation Targets' : 'Escalation Targets' ) } ]

%= include 'partials/_error_alert', message => $error

%= include 'partials/_card', title => 'Escalation Targets', header_class => '', body_class => 'p-2', header_extra => begin
    % if ($can_edit) {
    <button type="button" class="btn btn-sm btn-danger" id="target-add-btn">Add Target</button>
    % } elsif ($self->escalation_manage_enable) {
    <a class="btn btn-sm btn-outline-secondary" href="/escalation/edit">Edit</a>
    % }
% end, body => begin
    <div id="esc-action-status" class="small mb-2" style="display:none"></div>
    % if (@$targets) {
    <div class="table-responsive">
      <table class="table table-dark table-sm table-hover table-bordered mb-0" id="esc-targets-table">
        <thead class="table-secondary">
          <tr>
            <th>ID</th><th>Name</th><th>Type</th><th>Enabled</th><th>Description</th><th>Updated</th>
            % if ($can_edit) {
            <th></th>
            % }
          </tr>
        </thead>
        <tbody>
          % for my $target (@$targets) {
          <tr data-target-id="<%= $target->{id} %>">
            <td><%= $target->{id} %></td>
            <td><%= $target->{name} %></td>
            <td><%= $target->{type} %></td>
            <td>
              % if ($target->{enabled}) {
              <span class="badge bg-success">enabled</span>
              % } else {
              <span class="badge bg-secondary">disabled</span>
              % }
            </td>
            <td><%= $target->{description} // '' %></td>
            <td class="text-muted small"><%= $target->{updated} // '' %></td>
            % if ($can_edit) {
            <td class="text-nowrap">
              <button type="button" class="btn btn-sm btn-outline-secondary py-0 target-edit-btn"
                      data-target-id="<%= $target->{id} %>">Edit</button>
              <button type="button" class="btn btn-sm btn-outline-secondary py-0 target-test-btn"
                      data-target-id="<%= $target->{id} %>">Test</button>
              <button type="button" class="btn btn-sm btn-outline-danger py-0 target-delete-btn"
                      data-target-id="<%= $target->{id} %>" data-target-name="<%= $target->{name} %>">Delete</button>
            </td>
            % }
          </tr>
          % }
        </tbody>
      </table>
    </div>
    % } else {
    %= include 'partials/_empty_alert', message => "No escalation targets configured yet.", extra_class => "mb-0"
    % }
% end

% if ($can_edit) {
<!-- Target add/edit modal — the config form is built from the type's
     config_fields spec, so new escalation types need no template changes. -->
%= include 'partials/_modal', id => 'target-modal', title => 'Add Escalation Target', title_id => 'target-modal-title', dialog => 'modal-lg modal-dialog-scrollable', body => begin
  <input type="hidden" id="target-id" value="">
  <div class="row g-2 mb-2">
    <div class="col-md-6">
      <label class="form-label small text-muted mb-1">Name</label>
      <input type="text" id="target-name" class="form-control form-control-sm">
    </div>
    <div class="col-md-4">
      <label class="form-label small text-muted mb-1">Type</label>
      <select id="target-type" class="form-select form-select-sm"></select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="target-enabled" checked>
        <label class="form-check-label small" for="target-enabled">Enabled</label>
      </div>
    </div>
  </div>
  <div class="mb-2">
    <label class="form-label small text-muted mb-1">Description</label>
    <input type="text" id="target-description" class="form-control form-control-sm">
  </div>
  <div class="text-muted small mb-1" id="target-type-desc"></div>
  <div id="target-config-fields" class="row g-2 mb-2"></div>
  <div id="target-error" class="text-warning small" style="display:none"></div>
% end, footer => begin
  <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
  <button type="button" class="btn btn-sm btn-danger" id="target-save-btn">Save</button>
% end

<!-- Test result modal -->
%= include 'partials/_modal', id => 'test-result-modal', title => 'Test Escalation', title_id => 'test-result-title', dialog => 'modal-lg modal-dialog-scrollable', body => begin
  <div id="test-result-loading" class="text-center text-muted py-3">Sending test escalation…</div>
  <div id="test-result-content" style="display:none">
    <div id="test-result-error" class="text-warning small mb-2" style="display:none"></div>
    <div id="test-result-payload-wrap" style="display:none">
      <span class="text-muted small fw-semibold">Payload sent</span>
      <pre id="test-result-payload" class="small mt-1 mb-0"
           style="white-space:pre-wrap;max-height:400px;overflow-y:auto"></pre>
    </div>
  </div>
% end

<script>
// Server-supplied bootstrap data for /js/escalation.js.
window.LilithEscalation = { targets: <%== $targets_json %>, types: <%== $types_json %> };
</script>
<script src="/js/escalation.js"></script>
% }
