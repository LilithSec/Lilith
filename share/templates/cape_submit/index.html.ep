% layout 'default';
% title 'CAPE Submit';

%= include 'partials/_breadcrumb', crumbs => [ { label => "Search", url => "/search" }, { label => "CAPE Submit" } ]

%= include 'partials/_card', title => 'Submit a File for Detonation', header_class => '', body_class => 'p-3', title_span => 1, body => begin
    <form id="cape-submit-form">
      <div class="row g-3">
        <div class="col-md-6">
          <label for="cape-file" class="form-label small text-muted mb-1">File</label>
          <input type="file" class="form-control form-control-sm" id="cape-file" name="file" required>
        </div>
        % if (@$servers > 1) {
        <div class="col-md-3">
          <label for="cape-server" class="form-label small text-muted mb-1">Server</label>
          <select class="form-select form-select-sm" id="cape-server" name="server">
            % for my $server (@$servers) {
            <option value="<%= $server %>"><%= $server %></option>
            % }
          </select>
        </div>
        % } else {
        <input type="hidden" id="cape-server" name="server" value="<%= $servers->[0] %>">
        % }
        <div class="col-md-3">
          <label for="cape-slug" class="form-label small text-muted mb-1">Slug</label>
          <input type="text" class="form-control form-control-sm" id="cape-slug" name="slug"
                 value="<%= $default_slug %>">
        </div>
      </div>
      <div class="mt-3">
        <button type="submit" class="btn btn-sm btn-danger" id="cape-submit-btn">Submit to CAPE</button>
      </div>
    </form>

    <div id="cape-submit-status" class="small mt-3" style="display:none"></div>

    <div id="cape-submit-result" class="mt-3" style="display:none">
      <table class="table table-dark table-sm table-bordered mb-0">
        <tbody>
          <tr><th class="text-muted" style="width:9rem">Status</th><td id="cape-res-status"></td></tr>
          <tr><th class="text-muted">Server</th><td id="cape-res-server"></td></tr>
          <tr><th class="text-muted">Upload Name</th><td id="cape-res-name" class="text-break"></td></tr>
          <tr><th class="text-muted">HTTP</th><td id="cape-res-http"></td></tr>
          <tr><th class="text-muted">Magic</th><td id="cape-res-magic" class="text-break"></td></tr>
          <tr><th class="text-muted">Size</th><td id="cape-res-size"></td></tr>
          <tr><th class="text-muted">MD5</th><td id="cape-res-md5" class="text-break font-monospace"></td></tr>
          <tr><th class="text-muted">SHA1</th><td id="cape-res-sha1" class="text-break font-monospace"></td></tr>
          <tr><th class="text-muted">SHA256</th><td id="cape-res-sha256" class="text-break font-monospace"></td></tr>
        </tbody>
      </table>
    </div>
% end

<script src="/js/cape-submit.js"></script>
