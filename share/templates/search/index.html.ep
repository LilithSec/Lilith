% layout 'default';
% title 'Search';

% # Tom Select styles the classification pickers. Loaded through the layout's
% # head block so the stylesheet lands in <head> rather than mid-body.
% content_for head => begin
  <link href="/vendor/tom-select-2.6.2/css/tom-select.bootstrap5.min.css" rel="stylesheet">
% end

% # Every text filter this page offers, grouped the way the filter panel lays
% # them out. This table is the whole description of a filter: the panel renders
% # from it, the chips above the results take their labels from it, and the
% # show/hide by table is the data-tables it emits. Adding a filter is one line.
% #
% # - name :: the query parameter. Also the input's id, underscores to hyphens
% #   and '-input' appended, which is the convention /js/search.js binds its
% #   click-to-filter result cells to.
% #
% # - label :: plain text. Used on the chip, and as the form label unless
% #   form_label overrides it. Kept free of markup so a chip can never end up
% #   showing tags.
% #
% # - form_label :: optional richer label for the form only. Rendered unescaped,
% #   so it is for the literals below and nothing that came off a request.
% #
% # - width :: Bootstrap column width. 2 unless given.
% #
% # - tables :: the alert tables the filter applies to, space separated. Omit
% #   for one that applies to all of them.
% my @_filter_groups = (
%   {   heading => 'Network',
%       fields  => [
%           { name => 'src_ip',    label => 'Src IP' },
%           { name => 'src_port',  label => 'Src Port',  form_label => 'Src Port(s)' },
%           { name => 'dest_ip',   label => 'Dst IP' },
%           { name => 'dest_port', label => 'Dst Port',  form_label => 'Dst Port(s)' },
%           { name => 'ip',        label => 'IP',        form_label => 'IP (src <em>or</em> dst)' },
%           { name => 'port',      label => 'Port',      form_label => 'Port (src <em>or</em> dst)' },
%           { name => 'proto',     label => 'Proto' },
%           { name => 'app_proto', label => 'App Proto' },
%           { name => 'in_iface',  label => 'Interface' },
%       ],
%   },
%   {   heading => 'Instance / Host',
%       fields  => [
%           { name => 'instance',      label => 'Instance' },
%           { name => 'instance_host', label => 'Instance Host', tables => 'sagan cape' },
%           { name => 'host',          label => 'Host' },
%       ],
%   },
%   {   heading => 'Rule / Signature',
%       tables  => 'suricata sagan baphomet',
%       fields  => [
%           { name => 'signature', label => 'Signature', width => 3 },
%           { name => 'gid',       label => 'GID' },
%           { name => 'sid',       label => 'SID' },
%           { name => 'rev',       label => 'Rev' },
%           { name => 'event_id',  label => 'Event ID', width => 3 },
%           { name => 'username',  label => 'User', tables => 'baphomet' },
%       ],
%   },
%   {   heading => 'CAPE',
%       tables  => 'cape',
%       fields  => [
%           { name => 'target',           label => 'Target' },
%           { name => 'slug',             label => 'Slug' },
%           { name => 'pkg',              label => 'Package' },
%           { name => 'malscore',         label => 'Malscore' },
%           { name => 'size',             label => 'Size' },
%           { name => 'task',             label => 'Task ID' },
%           { name => 'subbed_from_ip',   label => 'Subbed From IP' },
%           { name => 'subbed_from_host', label => 'Subbed From Host' },
%           { name => 'md5',              label => 'MD5' },
%           { name => 'sha1',             label => 'SHA1' },
%           { name => 'sha256',           label => 'SHA256', width => 3 },
%       ],
%   },
% );
%
% # A filter with no tables of its own applies to every table there is, which
% # comes from the alert_tables helper so a new table needs nothing here.
% my $all_tables = join( ' ', map { $_->{key} } @{ $self->alert_tables } );
%
% # The flat list, in the order the chips appear. The classification pickers are
% # not in a group -- they live in their own column, hand written below -- so
% # they join on the end.
% my @_filter_fields = (
%   ( map { @{ $_->{fields} } } @_filter_groups ),
%   { name => 'class', label => 'Class' },
%   # class_not is the one filter the query string does not always spell out:
%   # the controller excludes GPCD on a fresh form. Chip it from what the
%   # search really ran with, which it stashed for exactly this.
%   { name => 'class_not', label => 'Not class', values => stash('effective_class_not') },
% );
% # only what was actually asked for opens the panel, so the GPCD default above
% # does not have every visit landing on an expanded form
% my $show_filters = grep { my $value = param( $_->{name} ); defined($value) && $value ne '' } @_filter_fields;

<form method="GET" action="/search" id="search-form">
  <input type="hidden" name="search" value="1">

  <div class="card mb-2 border-secondary">
    <div class="card-body py-2">
      <div class="row g-2 align-items-end">

        <div class="col-auto">
          <label class="form-label">Table</label>
          <select name="table" class="form-select form-select-sm" style="width:110px" id="table-sel">
            %= include 'partials/_table_options', selected => $table
          </select>
        </div>

        %= include 'partials/_time_range', tr_minutes => $go_back_minutes, tr_start => ( param('start') // '' ), tr_end => ( param('end') // '' )

        <div class="col-auto">
          <label class="form-label">Limit</label>
          <input type="number" name="limit" class="form-control form-control-sm"
                 value="<%= $limit %>" style="width:80px" min="1" max="10000">
        </div>

        <div class="col-auto">
          <label class="form-label">Offset</label>
          <input type="number" name="offset" class="form-control form-control-sm"
                 value="<%= $offset %>" style="width:80px" min="0">
        </div>

        <div class="col-auto">
          <label class="form-label">Order by</label>
          <select name="order_by" id="order-by" class="form-select form-select-sm" style="width:145px"></select>
        </div>

        <div class="col-auto">
          <label class="form-label">Dir</label>
          <select name="order_dir" class="form-select form-select-sm" style="width:88px">
            <option value="DESC" <%= $order_dir eq 'DESC' ? 'selected' : '' %>>DESC</option>
            <option value="ASC"  <%= $order_dir eq 'ASC'  ? 'selected' : '' %>>ASC</option>
          </select>
        </div>

        <div class="col-auto">
          <label class="form-label d-block">&nbsp;</label>
          <button type="button" class="btn btn-outline-secondary btn-sm"
                  data-bs-toggle="collapse" data-bs-target="#filter-panel">
            Filters
          </button>
        </div>

        <div class="col-auto">
          <label class="form-label d-block">&nbsp;</label>
          <div class="form-check mt-1">
            <input class="form-check-input" type="checkbox" id="show-host-col">
            <label class="form-check-label small" for="show-host-col">Host</label>
          </div>
        </div>

        <div class="col-auto">
          <label class="form-label d-block">&nbsp;</label>
          <button type="submit" class="btn btn-danger btn-sm px-4">Search</button>
        </div>

        <div class="col-auto ms-auto">
          <label class="form-label d-block">&nbsp;</label>
          <div class="d-flex align-items-center gap-2">
            <div class="form-check mb-0">
              <input class="form-check-input" type="checkbox" id="auto-fc" checked>
              <label class="form-check-label small" for="auto-fc"
                     title="Keep the filter area collapsed until the Filters button is clicked">Auto-FC</label>
            </div>
            <div class="form-check mb-0">
              <input class="form-check-input" type="checkbox" id="show-city" checked>
              <label class="form-check-label small" for="show-city"
                     title="Show the GeoIP city next to the country flag for each IP">City</label>
            </div>
            <div class="form-check mb-0">
              <input class="form-check-input" type="checkbox" id="show-shodan" checked>
              <label class="form-check-label small" for="show-shodan"
                     title="Show the cached Shodan tags, open port count, and CVE count for each IP">Shodan</label>
            </div>
            <div class="form-check mb-0">
              <input class="form-check-input" type="checkbox" id="auto-refresh">
              <label class="form-check-label small" for="auto-refresh">Auto-refresh</label>
            </div>
            <input type="number" id="auto-refresh-secs" class="form-control form-control-sm"
                   value="30" min="1" style="width:70px" title="Refresh interval in seconds">
            <span id="ar-status" class="small text-muted" style="white-space:nowrap"></span>
          </div>
        </div>

      </div><!-- /row -->
    </div><!-- /card-body -->
  </div><!-- /card -->

  % # Filter panel. Fields that only apply to some tables carry class
  % # search-filter-field and a data-tables list of the tables they belong to;
  % # /js/search.js hides the ones that do not match the selected table, so
  % # adding a table is an edit here rather than in the JavaScript.
  <div class="collapse <%= $show_filters ? 'show' : '' %>" id="filter-panel">
    <div class="card mb-2 border-secondary">
      <div class="card-header py-1 small text-muted">
        Filters — prefix <code>!</code> to negate, <code>%</code> for LIKE. Numeric fields accept comma-separated values e.g. <code>22,!80,&lt;1024</code>
      </div>
      <div class="card-body py-2">
        <div class="row g-2">

          <div class="col-md-9">

            % # One row per group, one column per filter, all of it from
            % # @_filter_groups above. Every row and field carries a data-tables
            % # list -- a filter with no tables of its own gets all of them --
            % # so /js/search.js needs no special cases.
            % my $last_group = scalar(@_filter_groups) - 1;
            % for my $group_index ( 0 .. $last_group ) {
            %   my $group = $_filter_groups[$group_index];
            <div class="row g-2 <%= $group_index < $last_group ? 'mb-1 ' : '' %>search-filter-field" data-tables="<%= $group->{tables} // $all_tables %>">
              <div class="col-12"><span class="text-muted small fw-semibold"><%= $group->{heading} %></span></div>

              % for my $field ( @{ $group->{fields} } ) {
              %   ( my $field_id = $field->{name} ) =~ s/_/-/g;
              %   $field_id .= '-input';
              <div class="col-md-<%= $field->{width} // 2 %> search-filter-field" data-tables="<%= $field->{tables} // $all_tables %>">
                <label class="form-label" for="<%= $field_id %>"><%== $field->{form_label} // $field->{label} %></label>
                <input type="text" name="<%= $field->{name} %>" id="<%= $field_id %>" class="form-control form-control-sm"
                       value="<%= param( $field->{name} ) // '' %>">
              </div>
              % }
            </div><!-- /<%= lc $group->{heading} %> row -->
            % }

          </div><!-- /filter rows col -->

          <div class="col-md-3 flex-column search-filter-field" data-tables="suricata sagan baphomet" style="display:flex">
            % # The ctrl/cmd-click hint only applies to the plain multi-select.
            % # /js/search.js drops it once Tom Select has taken the pickers over.
            <label class="form-label">Classification — match any of <span class="text-muted small multi-select-hint">(ctrl/cmd-click for multiple)</span></label>
            % my %_sel_class     = map { $_ => 1 } grep { defined($_) && $_ ne '' } @{ $self->every_param('class') };
            % my %_sel_class_not = map { $_ => 1 } grep { defined($_) && $_ ne '' } @{ $self->every_param('class_not') };
            % # on a fresh form default to excluding GPCD; submitted searches keep the user's choice
            % if ( !param('search') ) {
            %   $_sel_class_not{'Generic Protocol Command Decode'} = 1;
            % }
            <select name="class" class="form-select form-select-sm flex-grow-1" multiple>
              %= include 'partials/_class_options', selected => \%_sel_class
            </select>
            <label class="form-label mt-2">Classification — exclude all of</label>
            <select name="class_not" class="form-select form-select-sm flex-grow-1" multiple>
              %= include 'partials/_class_options', selected => \%_sel_class_not
            </select>
          </div><!-- /class filter col -->
        </div><!-- /row -->
      </div><!-- /card-body -->
    </div><!-- /card -->
  </div><!-- /collapse -->

</form>

% # Every chip URL sets search=1: without it the controller would read the URL
% # as a fresh form and put the GPCD exclusion back, so dropping that chip would
% # look like it did nothing.
%= include 'partials/_filter_chips', active => $self->filter_chips( \@_filter_fields, { search => 1 } )

%= include 'partials/_error_alert', message => $error

% if (defined $results) {
%= include 'search/_results'
% }

<script src="/js/time-range.js"></script>
<script src="/js/auto-refresh.js"></script>
<script src="/js/lilith-table.js"></script>
<script src="/vendor/tom-select-2.6.2/js/tom-select.complete.min.js"></script>
<script>
// Server-supplied bootstrap data for /js/search.js: the sortable columns per
// table, and the column the current results are ordered by.
window.LilithSearch = {
  orderByColumns: <%== $order_by_columns_json %>,
  orderBy:        '<%= $order_by %>'
};
</script>
<script src="/js/search.js"></script>
