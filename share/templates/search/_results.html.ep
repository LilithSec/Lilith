% # Results fragment — shared by the full search page and the partial (auto-refresh)
% # render. Expects $results (arrayref), $table, $offset, $limit set in the stash.
% # $escalated (hashref of row id => escalation count) is optional.
% my $count = scalar @$results;
% my $escalated = stash('escalated') || {};
% # The correlation lookups for the suricata table's badges, read once for the
% # whole page rather than per row.
% my $cve_matches   = stash('cve_matches')   || {};
% my $shodan_badges = stash('shodan_badges') || {};
% # Whether the port the flow names at an end is on that end's cached
% # open-port list.
% my $port_open = sub {
%   my ( $row, $end ) = @_;
%   my $port = $row->{ $end . '_port' };
%   return 0 unless defined $port && $port ne '';
%   my $shodan = $shodan_badges->{ $row->{ $end . '_ip' } // '' };
%   return $shodan && grep { $_ == $port } @{ $shodan->{ports} || [] };
% };
% # What the crawl saw running on the port the flow names at an end, '' when
% # nothing was paired. The per-address map is built once however many rows
% # name the address.
% my %port_product_maps;
% my $port_product = sub {
%   my ( $row, $end ) = @_;
%   my $port = $row->{ $end . '_port' };
%   return '' unless defined $port && $port ne '';
%   my $ip = $row->{ $end . '_ip' } // '';
%   my $shodan = $shodan_badges->{$ip} or return '';
%   my $map = $port_product_maps{$ip} ||= $self->shodan_port_products( $shodan->{port_products} );
%   return $map->{$port} // '';
% };
<div id="search-results">
  %= include 'partials/_results_pager', count => $count, noun => 'result', offset => $offset, limit => $limit

  % if ($count > 0) {
  <div class="table-responsive">
    <table class="table table-dark table-sm table-hover table-bordered mb-0">

      % if ($table eq 'suricata') {
      <thead class="table-secondary">
        <tr>
          <th>ID</th><th>Timestamp</th><th>Instance</th><th class="col-host" style="display:none">Host</th><th>If</th>
          <th>Src IP</th><th>Sport</th><th>Dst IP</th><th>Dport</th>
          <th>Proto</th><th>AProto</th><th>Class</th><th>Signature</th><th>Rule</th>
        </tr>
      </thead>
      <tbody>
        % for my $row (@$results) {
        <tr>
          <td><%= include 'partials/_event_id_cell', table => $table, row_id => $row->{id}, escalation_count => $escalated->{$row->{id}} %></td>
          <td><%= $row->{timestamp} // '' %></td>
          <td><% if (my $instance = $row->{instance}) { %><a href="#" class="instance-filter" data-instance="<%= $instance %>"><%= $instance %></a><% } %></td>
          <td class="col-host" style="display:none"><% if (my $host = $row->{host}) { %><a href="#" class="host-filter" data-host="<%= $host %>"><%= $host %></a><% } %></td>
          <td><% if (my $in_iface = $row->{in_iface}) { %><a href="#" class="iface-filter" data-iface="<%= $in_iface %>"><%= $in_iface %></a><% } %></td>
          % # The correlation badges, on either end: "CVE match" when the rule
          % # names a CVE that end's cached entry lists it as vulnerable to
          % # (ids in the tooltip), "open" when the port hit at that end is on
          % # its cached open-port list; absence shows nothing. Inside
          % # .shodan-badges so the Shodan toggle governs them with the rest
          % # of the enrichment.
          % my $row_matches = $cve_matches->{ $row->{id} } || {};
          <td class="ip-cell"><%= include 'partials/_ip_cell', ip => $row->{src_ip} %><%
            if (my $matched = $row_matches->{src}) { %> <span class="shodan-badges"><span class="badge bg-danger" title="rule CVE the source is vulnerable to per Shodan: <%= join(', ', @$matched) %>">CVE match</span></span><% } %></td>
          <td><% if (my $src_port = $row->{src_port})  { %><a href="#" class="port-filter" data-port="<%= $src_port %>"><%= $src_port %></a><%
            if (my $product = $port_product->($row, 'src')) { %> <span class="shodan-badges text-muted">(<%= $product %>)</span><% } %><%
            if ($port_open->($row, 'src')) { %> <span class="shodan-badges"><span class="badge bg-secondary" title="Shodan sees this port open on the source">open</span></span><% } %><% } %></td>
          <td class="ip-cell"><%= include 'partials/_ip_cell', ip => $row->{dest_ip} %><%
            if (my $matched = $row_matches->{dest}) { %> <span class="shodan-badges"><span class="badge bg-danger" title="rule CVE the destination is vulnerable to per Shodan: <%= join(', ', @$matched) %>">CVE match</span></span><% } %></td>
          <td><% if (my $dest_port = $row->{dest_port}) { %><a href="#" class="port-filter" data-port="<%= $dest_port %>"><%= $dest_port %></a><%
            if (my $product = $port_product->($row, 'dest')) { %> <span class="shodan-badges text-muted">(<%= $product %>)</span><% } %><%
            if ($port_open->($row, 'dest')) { %> <span class="shodan-badges"><span class="badge bg-secondary" title="Shodan sees this port open on the destination">open</span></span><% } %><% } %></td>
          <td><% if (my $proto = $row->{proto}) { %><a href="#" class="proto-filter" data-proto="<%= $proto %>"><%= $proto %></a><% } %></td>
          <td><% if (my $app_proto = $row->{app_proto}) { %><a href="#" class="aproto-filter" data-aproto="<%= $app_proto %>"><%= $app_proto %></a><% } %></td>
          <td title="<%= $row->{classification} // '' %>">
            <%= $self->lilith->get_short_class($row->{classification}) %>
          </td>
          <td><% if (my $signature = $row->{signature}) { %><a href="#" class="sig-filter" data-sig="<%= $signature %>"><%= $signature %></a><% } %></td>
          <td class="text-muted"><%= include 'partials/_rule_cell', row => $row %></td>
        </tr>
        % }
      </tbody>

      % } elsif ($table eq 'sagan') {
      <thead class="table-secondary">
        <tr>
          <th>ID</th><th>Timestamp</th><th>Instance</th><th class="col-host" style="display:none">Instance Host</th>
          <th>Src IP</th><th>Sport</th><th>Host</th><th>Program</th>
          <th>Facility</th><th>Level</th><th>Priority</th>
          <th>Class</th><th>Signature</th><th>Rule</th>
        </tr>
      </thead>
      <tbody>
        % for my $row (@$results) {
        <tr>
          <td><%= include 'partials/_event_id_cell', table => $table, row_id => $row->{id}, escalation_count => $escalated->{$row->{id}} %></td>
          <td><%= $row->{timestamp} // '' %></td>
          <td><% if (my $instance = $row->{instance}) { %><a href="#" class="instance-filter" data-instance="<%= $instance %>"><%= $instance %></a><% } %></td>
          <td class="col-host" style="display:none"><% if (my $instance_host = $row->{instance_host}) { %><a href="#" class="instance-host-filter" data-instance-host="<%= $instance_host %>"><%= $instance_host %></a><% } %></td>
          <td class="ip-cell"><%= include 'partials/_ip_cell', ip => $row->{src_ip} %></td>
          <td><% if (my $src_port = $row->{src_port})  { %><a href="#" class="port-filter" data-port="<%= $src_port %>"><%= $src_port %></a><%
            if (my $product = $port_product->($row, 'src')) { %> <span class="shodan-badges text-muted">(<%= $product %>)</span><% } %><% } %></td>
          <td><%= $row->{host}      // '' %></td>
          <td><%= $row->{program}   // '' %></td>
          <td><%= $row->{facility}  // '' %></td>
          <td><%= $row->{level}     // '' %></td>
          <td><%= $row->{priority}  // '' %></td>
          <td title="<%= $row->{classification} // '' %>">
            <%= $self->lilith->get_short_class($row->{classification}) %>
          </td>
          <td><% if (my $signature = $row->{signature}) { %><a href="#" class="sig-filter" data-sig="<%= $signature %>"><%= $signature %></a><% } %></td>
          <td class="text-muted"><%= include 'partials/_rule_cell', row => $row %></td>
        </tr>
        % }
      </tbody>

      % } elsif ($table eq 'cape') {
      <thead class="table-secondary">
        <tr>
          <th>ID</th><th>Instance</th><th class="col-host" style="display:none">Instance Host</th><th>Target</th><th>Malscore</th>
          <th>Package</th><th>Size</th><th>MD5</th><th>SHA256</th>
          <th>Subbed From</th>
        </tr>
      </thead>
      <tbody>
        % for my $row (@$results) {
        <tr>
          <td><%= include 'partials/_event_id_cell', table => $table, row_id => $row->{id}, escalation_count => $escalated->{$row->{id}} %></td>
          <td><% if (my $instance = $row->{instance}) { %><a href="#" class="instance-filter" data-instance="<%= $instance %>"><%= $instance %></a><% } %></td>
          <td class="col-host" style="display:none"><% if (my $instance_host = $row->{instance_host}) { %><a href="#" class="instance-host-filter" data-instance-host="<%= $instance_host %>"><%= $instance_host %></a><% } %></td>
          <td><%= $row->{target}    // '' %></td>
          <td><%= $row->{malscore}  // '' %></td>
          <td><%= $row->{pkg}       // '' %></td>
          <td><%= $row->{size}      // '' %></td>
          <td><small class="text-muted"><%= $row->{md5}    // '' %></small></td>
          <td><small class="text-muted"><%= defined $row->{sha256} ? substr($row->{sha256}, 0, 16) . '…' : '' %></small></td>
          <td>
            <%= $row->{subbed_from_ip} // '' %>
            % if ($row->{subbed_from_host}) {
            <small class="text-muted">(<%= $row->{subbed_from_host} %>)</small>
            % }
          </td>
        </tr>
        % }
      </tbody>

      % } else { # baphomet
      <thead class="table-secondary">
        <tr>
          <th>ID</th><th>Timestamp</th><th>Instance</th><th class="col-host" style="display:none">Host</th>
          <th>Event</th><th>Src IP</th><th>Sport</th><th>Dst IP</th><th>Dport</th><th>User</th><th>Subjects</th>
          <th>Severity</th><th>Class</th><th>Signature</th>
          % # bucketed searches compress each (instance, signature, subjects)
          % # group to its newest row; Count is how many that row stands for
          % if ($bucket) {
          <th>Count</th>
          % }
        </tr>
      </thead>
      <tbody>
        % for my $row (@$results) {
        <tr>
          <td><%= include 'partials/_event_id_cell', table => $table, row_id => $row->{id}, escalation_count => $escalated->{$row->{id}} %></td>
          <td><%= $row->{timestamp} // '' %></td>
          <td><% if (my $instance = $row->{instance}) { %><a href="#" class="instance-filter" data-instance="<%= $instance %>"><%= $instance %></a><% } %></td>
          <td class="col-host" style="display:none"><% if (my $host = $row->{host}) { %><a href="#" class="host-filter" data-host="<%= $host %>"><%= $host %></a><% } %></td>
          <td><%= $row->{event_type} // '' %></td>
          <td class="ip-cell"><%= include 'partials/_ip_cell', ip => $row->{src_ip} %></td>
          <td><% if (my $src_port = $row->{src_port})  { %><a href="#" class="port-filter" data-port="<%= $src_port %>"><%= $src_port %></a><%
            if (my $product = $port_product->($row, 'src')) { %> <span class="shodan-badges text-muted">(<%= $product %>)</span><% } %><% } %></td>
          <td class="ip-cell"><%= include 'partials/_ip_cell', ip => $row->{dest_ip} %></td>
          <td><% if (my $dest_port = $row->{dest_port}) { %><a href="#" class="port-filter" data-port="<%= $dest_port %>"><%= $dest_port %></a><%
            if (my $product = $port_product->($row, 'dest')) { %> <span class="shodan-badges text-muted">(<%= $product %>)</span><% } %><% } %></td>
          <td><% if (my $username = $row->{username}) { %><a href="#" class="user-filter" data-user="<%= $username %>"><%= $username %></a><% } %></td>
          <td><small><%= include 'partials/_subjects_cell', subjects => $row->{subjects} %></small></td>
          <td><%= $row->{severity} // '' %></td>
          <td title="<%= $row->{classification} // '' %>">
            <%= $self->lilith->get_short_class($row->{classification}) %>
          </td>
          <td><% if (my $signature = $row->{signature}) { %><a href="#" class="sig-filter" data-sig="<%= $signature %>"><%= $signature %></a><% } %></td>
          % # The count links to the bucket's contents: the same search,
          % # unbucketed, narrowed to this row's instance/signature/subjects
          % # (subjects_key -- a VAR=value component per var, or the whole
          % # set as JSON where components cannot express it). Every other
          % # filter and the window carry over, so the rows shown are the
          % # rows counted. search=1 keeps the controller from re-adding
          % # the fresh-form GPCD exclusion, and offset/partial are dropped
          % # for the same reasons the chips drop them.
          % if ($bucket) {
          <td class="bucket-count"><a href="<%= url_with->query({
               search    => 1,
               bucket    => undef,
               offset    => undef,
               partial   => undef,
               instance  => $row->{instance},
               signature => $row->{signature},
               subjects  => $row->{subjects_key},
             }) %>" title="show the events this row stands for"><%= $row->{bucket_count} // '' %></a></td>
          % }
        </tr>
        % }
      </tbody>
      % }

    </table>
  </div><!-- /table-responsive -->

  % } else {
  %= include 'partials/_empty_alert', message => "No results found."
  % }
</div><!-- /search-results -->
