% layout 'default';
% title 'Logs';

% # Tom Select styles the token filter fields, as on /search. Loaded through the
% # layout's head block so the stylesheet lands in <head> rather than mid-body.
% content_for head => begin
  <link href="/vendor/tom-select-2.6.2/css/tom-select.bootstrap5.min.css" rel="stylesheet">
% end

% # Filter fields, each tagged with the sources it applies to. The JS below shows
% # only those matching the selected source, mirroring the search page's per-table
% # toggle. 'suggest' marks a field whose dropdown offers the values that occur,
% # fetched from /api/logs/values when it is focused -- set where the column is
% # one the source can be grouped by (a source that cannot answers 400 and the
% # field simply stays free text). message is a substring match, so a list of
% # exact values would say nothing.
% my @filter_fields = (
%   { name => 'host',      label => 'Host(s)',    sources => 'syslog http http_error http_all', suggest => 1 },
%   { name => 'program',   label => 'Program(s)', sources => 'syslog', suggest => 1 },
%   { name => 'facility',  label => 'Facility',  sources => 'syslog', suggest => 1 },
%   { name => 'priority',  label => 'Priority',  sources => 'syslog', suggest => 1 },
%   { name => 'vhost',     label => 'VHost(s)',   sources => 'http http_error http_all', suggest => 1 },
%   { name => 'client_ip', label => 'Client IP', sources => 'http http_error http_all', suggest => 1 },
%   { name => 'method',    label => 'Method',    sources => 'http', suggest => 1 },
%   { name => 'status',    label => 'Status',    sources => 'http', suggest => 1 },
%   { name => 'loglevel',  label => 'Log Level', sources => 'http_error', suggest => 1 },
%   { name => 'code',      label => 'Code',      sources => 'http_error', suggest => 1 },
%   { name => 'message',   label => 'Message (substring)', sources => 'syslog http_all' },
% );
% my $show_filters = grep { my $value = param($_->{name}); defined($value) && $value ne '' } @filter_fields;

<form method="GET" action="/logs" id="logs-form">

  <div class="card mb-2 border-secondary">
    <div class="card-body py-2">
      <div class="row g-2 align-items-end">

        <div class="col-auto">
          <label class="form-label">Source</label>
          <select name="source" class="form-select form-select-sm" style="width:150px" id="source-sel">
            % for my $source_option (@$sources) {
            <option value="<%= $source_option->{key} %>" <%= $source eq $source_option->{key} ? 'selected' : '' %>><%= $source_option->{label} %></option>
            % }
          </select>
        </div>

        % if (defined stash('around') && stash('around') ne '') {
        <div class="col-auto">
          <label class="form-label">Window</label>
          <div class="d-flex align-items-center gap-2" style="height:31px">
            <span class="badge bg-info text-dark" title="Anchored around this time">±<%= stash('window') %> min · <%= stash('around') %></span>
            <a href="<%= url_with->query({around => undef, window => undef, partial => undef}) %>" class="small">clear</a>
          </div>
          <input type="hidden" name="around" value="<%= stash('around') %>">
          <input type="hidden" name="window" value="<%= stash('window') %>">
        </div>
        % } else {
        %= include 'partials/_time_range', tr_minutes => $go_back_minutes, tr_start => ( param('start') // '' ), tr_end => ( param('end') // '' )
        % }

        <div class="col-auto">
          <label class="form-label">Limit</label>
          <input type="number" name="limit" class="form-control form-control-sm"
                 value="<%= $limit %>" style="width:80px" min="1" max="10000">
        </div>

        <div class="col-auto">
          <label class="form-label">Offset</label>
          <input type="number" name="offset" class="form-control form-control-sm"
                 value="<%= $offset %>" style="width:80px" min="0">
        </div>

        <div class="col-auto">
          <label class="form-label">Dir</label>
          <select name="order_dir" class="form-select form-select-sm" style="width:88px">
            <option value="DESC" <%= $order_dir eq 'DESC' ? 'selected' : '' %>>DESC</option>
            <option value="ASC"  <%= $order_dir eq 'ASC'  ? 'selected' : '' %>>ASC</option>
          </select>
        </div>

        <div class="col-auto">
          <label class="form-label d-block">&nbsp;</label>
          <button type="button" class="btn btn-outline-secondary btn-sm"
                  data-bs-toggle="collapse" data-bs-target="#logs-filter-panel">Filters</button>
        </div>

        <div class="col-auto">
          <label class="form-label d-block">&nbsp;</label>
          <button type="submit" class="btn btn-danger btn-sm px-4">Search</button>
        </div>

        <div class="col-auto ms-auto">
          <label class="form-label d-block">&nbsp;</label>
          <div class="d-flex align-items-center gap-2">
            <div class="form-check mb-0">
              <input class="form-check-input" type="checkbox" id="logs-auto-refresh">
              <label class="form-check-label small" for="logs-auto-refresh">Auto-refresh</label>
            </div>
            <input type="number" id="logs-auto-refresh-secs" class="form-control form-control-sm"
                   value="30" min="1" style="width:70px" title="Refresh interval in seconds">
            <span id="logs-ar-status" class="small text-muted" style="white-space:nowrap"></span>
          </div>
        </div>

      </div><!-- /row -->
    </div><!-- /card-body -->
  </div><!-- /card -->

  <div class="collapse <%= $show_filters ? 'show' : '' %>" id="logs-filter-panel">
    <div class="card mb-2 border-secondary">
      <div class="card-header py-1 small text-muted">
        Filters — every field takes more than one value (type and press enter or comma), several values match any of them. <code>%</code> for LIKE on host/program; message is a substring match.
      </div>
      <div class="card-body py-2">
        <div class="row g-2">
          % # Each field is a <select multiple> holding one option per value in
          % # force, which the shared /js/token-fields.js turns into a
          % # type-to-add token field -- one query parameter per value, so each
          % # gets its own chip above the results. The id convention (name,
          % # underscores to hyphens, '-input' appended) is what the
          % # click-to-filter cells in the results resolve their field by.
          % for my $field (@filter_fields) {
          %   ( my $field_id = $field->{name} ) =~ s/_/-/g;
          %   $field_id .= '-input';
          %   my @in_force = grep { defined($_) && $_ ne '' } @{ $self->every_param( $field->{name} ) };
          <div class="col-md-2 log-filter-field" data-sources="<%= $field->{sources} %>">
            <label class="form-label" for="<%= $field_id %>"><%= $field->{label} %></label>
            <select name="<%= $field->{name} %>" id="<%= $field_id %>" class="form-select form-select-sm token-filter-field" multiple
                    <%== $field->{suggest} ? 'data-column="' . $field->{name} . '"' : '' %>>
              % for my $value (@in_force) {
              <option value="<%= $value %>" selected><%= $value %></option>
              % }
            </select>
          </div>
          % }
        </div>
      </div>
    </div>
  </div>

</form>

% # Chips for the filters in force. Only the ones the selected source accepts:
% # the form submits its hidden fields too, so a filter left over from another
% # source can sit in the URL without the reader ever having applied it. It
% # comes back the moment that source is selected again.
% my @_active_filter_fields = grep {
%   my $field_sources = $_->{sources};
%   grep { $_ eq $source } split( /\s+/, $field_sources );
% } @filter_fields;
%= include 'partials/_filter_chips', active => $self->filter_chips( \@_active_filter_fields )

%= include 'partials/_error_alert', message => $error

% if (defined $result) {
%= include 'logs/_results'
% }

<script src="/js/time-range.js"></script>
<script src="/js/auto-refresh.js"></script>
<script src="/vendor/tom-select-2.6.2/js/tom-select.complete.min.js"></script>
<script src="/js/token-fields.js"></script>
<script src="/js/logs.js"></script>
