% # Bootstrap dark modal shell, shared by every modal in the UI. Include it with
% # a body block, and a footer block when the modal has one:
% #   %= include 'partials/_modal', id => 'ipinfo-modal', title => 'IP Info',
% #       dialog => 'modal-lg modal-dialog-scrollable', title_id => 'ipinfo-modal-title',
% #       body => begin
% #   ...markup...
% #   % end
% #
% # - id :: modal element id
% # - title :: header text
% # - dialog :: extra .modal-dialog classes (size / scrollable); none by default
% # - title_id :: id for the <h6>, for modals whose title is rewritten by JS
% # - body :: required content block
% # - footer :: optional content block, rendered in a .modal-footer
% my $dialog   = stash('dialog') // '';
% my $title_id = stash('title_id');
% my $footer   = stash('footer');
<div class="modal fade" id="<%= $id %>" tabindex="-1">
  <div class="modal-dialog<%= $dialog ne '' ? " $dialog" : '' %>">
    <div class="modal-content bg-dark text-light border-secondary">
      <div class="modal-header py-2 border-secondary">
        <h6 class="modal-title"<% if ($title_id) { %> id="<%= $title_id %>"<% } %>><%= $title %></h6>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        %= $body->()
      </div>
      % if ($footer) {
      <div class="modal-footer py-2 border-secondary">
        %= $footer->()
      </div>
      % }
    </div>
  </div>
</div>
