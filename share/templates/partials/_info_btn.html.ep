% # The small "?" button that opens the layout's IP or Domain info modal. The
% # modal and lookup live in the layout; the page JS only binds the class. Use:
% #   %= include 'partials/_info_btn', kind => 'domain', value => $http->{hostname}
% #
% # kind        - 'ip' or 'domain', picking the data attribute and bound class
% # value       - the IP or domain to look up
% # extra_class - extra classes, e.g. the 'ms-1' the inline uses want
% my $kind        = stash('kind');
% my $extra_class = stash('extra_class') // '';
% my $data_attr   = $kind eq 'ip' ? 'data-ip' : 'data-domain';
<button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1 info-btn <%= $kind %>-info-btn<%= $extra_class ne '' ? " $extra_class" : '' %>" <%= $data_attr %>="<%= $value %>">?</button>
